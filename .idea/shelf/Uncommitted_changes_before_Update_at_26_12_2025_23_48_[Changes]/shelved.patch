oma.db:/app/chroma.db\r\n      # Монтирование директории для временных файлов\r\n      - ../../minio_data/dnd-books:/app/dnd-books:ro\r\n    networks:\r\n      - ai_dnd_network\r\n    restart: unless-stopped\r\n    depends_on:\r\n      - minio\r\n    deploy:\r\n      resources:\r\n        limits:\r\n          memory: 8G\r\n          cpus: '4.0'\r\n        reservations:\r\n          memory: 4G\r\n          cpus: '2.0'\r\n          devices:\r\n            - driver: nvidia\r\n              count: 1\r\n              capabilities: [gpu]\r\n\r\n# Объявление сети\r\nnetworks:\r\n  ai_dnd_network:\r\n    driver: bridge\r\n\r\n# Объявление volumes для постоянного хранения данных\r\nvolumes:\r\n  db_data:\r\n  minio_data:\r\n  ollama_data:\r\n  n8n_data:\r\n  rag_chroma_db:\r\n    # Для хранения векторного индекса ChromaDB\r\n  rag_temp_data:\r\n    # Для временных файлов при обработке PDF
