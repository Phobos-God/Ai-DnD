<+># Stage 1: Базовый образ с предустановленными тяжелыми зависимостями\r\nFROM nvidia/cuda:12.6.0-devel-ubuntu22.04 AS base-deps\r\n\r\n# Определение аргументов сборки\r\nARG TORCH_VERSION=2.7.1\r\nARG CUDA_TAG=cu126\r\n\r\n# Установка кэшированного источника пакетов для ускорения сборки\r\nENV DEBIAN_FRONTEND=noninteractive\r\nRUN mkdir -p /etc/apt/apt.conf.d && \\\r\n    echo 'Acquire::Retries \"3\";' > /etc/apt/apt.conf.d/80-retries && \\\r\n    echo 'Acquire::http::Timeout \"60\";' > /etc/apt/apt.conf.d/80-timeout\r\n\r\n# Установка Python и системных зависимостей\r\nRUN apt-get update && apt-get install -y --no-install-recommends \\\r\n    python3.11 \\\r\n    python3.11-dev \\\r\n    python3.11-venv \\\r\n    python3-pip \\\r\n    gcc \\\r\n    g++ \\\r\n    && rm -rf /var/lib/apt/lists/* \\\r\n    \\\r\n    && python3.11 -m pip install --upgrade pip setuptools wheel \\\r\n    \\\r\n    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*\r\n\r\nWORKDIR /app\r\n\r\n# Копирование предварительно загруженных wheel-файлов\r\nCOPY wheels/ /tmp/wheels/\r\n\r\n# Установка PyTorch из локальных wheel-файлов\r\nRUN python3.11 -m pip install --no-cache-dir /tmp/wheels/*.whl\r\n\r\n# Проверка установки PyTorch (без проверки CUDA, так как GPU недоступен на этапе сборки)\r\nRUN python3.11 -c \"import torch; print('Torch:', torch.__version__); print('CUDA version:', torch.version.cuda)\"\r\n\r\n# Создаем отдельный образ для базовых Python-зависимостей\r\nFROM base-deps AS core-deps\r\n\r\n# Копирование app-зависимостей\r\nCOPY requirements-app.txt .\r\n\r\n# Установка остальных зависимостей\r\nRUN pip install --no-cache-dir --disable-pip-version-check --timeout 600 --retries 40 -r requirements-app.txt\r\n\r\n# Основной образ приложения (оптимизированный)\r\nFROM nvidia/cuda:12.6.0-runtime-ubuntu22.04 AS rag-service\r\n\r\n# Определение аргументов сборки (дублирование для runtime stage)\r\nARG TORCH_VERSION=2.7.1\r\nARG CUDA_TAG=cu126\r\n\r\n# Установка переменных окружения для CUDA\r\nENV DEBIAN_FRONTEND=noninteractive\r\nENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512\r\nENV CUDA_VISIBLE_DEVICES=0\r\n\r\n# Установка Python\r\nRUN apt-get update && apt-get install -y --no-install-recommends \\\r\n    python3.11 \\\r\n    python3.11-venv \\\r\n    python3-pip \\\r\n    && rm -rf /var/lib/apt/lists/*\r\n\r\n# Создание пользователя безопасности\r\nRUN useradd -m appuser\r\n\r\n# Копирование Python-зависимостей из core-deps\r\nCOPY --from=core-deps /usr/local/lib/python3.11 /usr/local/lib/python3.11\r\nCOPY --from=core-deps /usr/local/bin /usr/local/bin\r\n\r\n# Установка рабочей директории\r\nWORKDIR /app\r\n\r\n# Копирование приложения\r\nCOPY app/ /app/\r\n\r\n# Копирование конфигурации\r\nCOPY config.yaml /app/config.yaml\r\n\r\n# Создание директории для векторного хранилища\r\nRUN mkdir -p /app/chroma.db\r\n\r\n# Смена пользователя на безопасного\r\nUSER appuser\r\n\r\n# Экспорт порта\r\nEXPOSE 8080\r\n\r\n# Добавление HEALTHCHECK\r\nHEALTHCHECK CMD curl -f http://localhost:80/health || exit 1\r\n\r\n# Запуск приложения\r\nCMD [\"python3.11\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8080\", \"--workers\", \"1\"]
